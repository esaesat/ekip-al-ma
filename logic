from database import Database

class ExpenseLogic:
    def __init__(self, db: Database):
        self.db = db

    def process_and_add_expense(self, user_id, amount, category, description):
        # İş Kuralı: Tutar 0 veya daha küçük olamaz!
        if amount <= 0:
            print("[Hata] Geçersiz harcama tutarı! Tutar 0'dan büyük olmalıdır.")
            return False

        # Kategori boşsa "Genel" yapalım
        final_category = category if category else "Genel"
        final_desc = description if description else "Açıklama girilmedi"

        success = self.db.add_expense(user_id, amount, final_category, final_desc)
        if success:
            print("[Başarılı] Harcama veritabanına kaydedildi.")
        return success

    def generate_daily_report(self, user_id):
        print("\n=== GÜN SONU RAPORU ===")
        rows = self.db.get_daily_summary(user_id)
        
        if not rows:
            print("Bugün henüz kayıtlı bir harcamanız yok.")
            return
            
        total_spent = 0
        for category, total in rows:
            print(f"Kategori: {category} | Toplam: {total} TL")
            total_spent += total
            
        print(f"Genel Toplam: {total_spent} TL")
        print("=======================\n")
